+fn read_hex4(s: &str, start: usize) -> Option<(u16, usize)> {
+    let end = start.checked_add(4)?;
+    let hex = s.get(start..end)?;
+    if !hex.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return None;
+    }
+    Some((u16::from_str_radix(hex, 16).ok()?, end))
+}
