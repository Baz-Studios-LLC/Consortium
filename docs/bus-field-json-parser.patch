+fn skip_json_value(s: &str) -> Option<&str> {
+    let s = s.trim_start();
+    if s.starts_with('"') {
+        let (_, rest) = parse_json_string(s)?;
+        return Some(rest);
+    }
+
+    let end = s
+        .char_indices()
+        .find(|(_, c)| matches!(c, ',' | '}'))
+        .map(|(i, _)| i)
+        .unwrap_or(s.len());
+    Some(&s[end..])
+}
